{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maya-perfume-house5",
  "main": "artifacts/api-server/src/cloudflare-worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "artifacts/maya-perfume-shop/dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "previews": {
    "vars": {
      "NODE_ENV": "development"
    }
  }
}
