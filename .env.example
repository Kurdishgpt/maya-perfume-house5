# Add these values through Replit Secrets for hosted workflows.
# Optional server-only URL; when empty, the API uses VITE_SUPABASE_URL.
SUPABASE_URL=
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
ADMIN_PANEL_PASSWORD=choose-a-strong-admin-passphrase
SESSION_SECRET=replace-with-a-long-random-session-secret

# Optional source for the admin-only one-time legacy data transfer.
# Do not use Replit's default DATABASE_URL for this.
LEGACY_DATABASE_URL=postgresql://user:password@legacy-database-host:5432/database

# Optional server-side key for fragrance drafting.
GEMINI_API_KEY=
